<Project>
  <!-- server-cs 아래 모든 프로젝트의 공통 설정. 프로젝트 파일에는 다른 점만 적는다. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- C++의 /W4처럼 경고를 많이 본다. 안전 우선: nullable 경고는 에러로 막는다. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <!-- 소스를 UTF-8로 본다(C++의 /utf-8과 같은 목적). -->
    <CodePage>65001</CodePage>
    <!-- Trace.Assert(= C++ ASSERT, Release 에서도 검사)는 TRACE 기호가 있어야 남는다. SDK 기본값이지만 빠지면 검사가
         소리 없이 사라지므로 명시한다. 빠지면 Base.Tests 의 AssertTest 가 깨진다. -->
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>
</Project>
