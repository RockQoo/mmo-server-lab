<Project Sdk="Microsoft.NET.Sdk">
  <!-- C++ server-cpp/Core/Base 와 같은 라이브러리. namespace도 Base. -->
  <PropertyGroup>
    <RootNamespace>Base</RootNamespace>
    <AssemblyName>Base</AssemblyName>
  </PropertyGroup>

  <!-- 테스트는 같은 폴더 아래 Tests/에 따로 프로젝트로 있다. 이 프로젝트에 섞여 컴파일되지 않게 뺀다. -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- CrashDump: 살아 있는 프로세스 덤프(MS 공식, dotnet-dump 가 쓰는 것) -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
  </ItemGroup>
</Project>
