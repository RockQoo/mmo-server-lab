<Project Sdk="Microsoft.NET.Sdk">
  <!-- C++ BaseTests(gtest)와 같은 자리. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Base.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Base.csproj" />
  </ItemGroup>

  <!-- C++ 테스트와 같이 쓰는 정답 파일(저장소 최상위 testdata/)을 출력 폴더의 testdata/로 복사한다. -->
  <ItemGroup>
    <None Include="..\..\..\..\testdata\**\*" LinkBase="testdata" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
