<Project Sdk="Microsoft.NET.Sdk">
  <!-- C++ MetricsTests(gtest)와 같은 자리. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Metrics.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Metrics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- FakeTimeProvider: MetricsReporter 의 초당 개수를 시간을 직접 넘겨 시험한다(Scheduling.Tests 와 같은 패키지) -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
