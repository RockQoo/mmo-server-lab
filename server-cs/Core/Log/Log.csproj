<Project Sdk="Microsoft.NET.Sdk">
  <!-- C++ server-cpp/Core/Log 과 같은 역할. 구현은 Serilog(2026-11-26 결정). namespace도 Log. -->
  <PropertyGroup>
    <RootNamespace>Log</RootNamespace>
    <AssemblyName>Log</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <!-- 크래시 처리기(Logger.OnCrash)는 프로세스를 죽이지 않고는 부를 수 없어 테스트가 직접 부른다 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Log.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>
