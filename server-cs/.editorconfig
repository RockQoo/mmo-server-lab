# server-cs 코드 분석 설정. 기본은 Directory.Build.props 의 "모든 규칙(latest-all) + 경고 = 에러".
# 여기서는 설계상 해당하지 않는 규칙만, 해당하는 파일에서만 끈다(이유를 함께 적는다).

# 코덱(IByteCodec<T> 를 구현하는 struct). 비교하지 않는 표시용 타입이고, static 멤버는 static abstract 인터페이스 구현이다.
#   CA1815 struct 는 Equals/== 를 재정의하라   CA1000 제네릭 타입에 static 멤버를 두지 마라
[**/ByteCodecs.cs]
dotnet_diagnostic.CA1815.severity = none
dotnet_diagnostic.CA1000.severity = none
